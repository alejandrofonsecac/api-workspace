# Copie para .env e preencha com valores locais. O .env é ignorado pelo Git: nunca o commite.
# Em produção, configure estas variáveis no ambiente de hospedagem.

# Conexão PostgreSQL
API_URL=jdbc:postgresql://localhost:5432/workspace
API_USER=workspace
API_PASSWORD=

# Base64 de no mínimo 32 bytes aleatórios; veja .docs/operations/API_OPERATION.md
JWT_SECRET=

# Opcionais
# CORS_ALLOWED_ORIGINS=http://localhost:4200
# APP_TIME_ZONE=America/Sao_Paulo
# JPA_SHOW_SQL=false
